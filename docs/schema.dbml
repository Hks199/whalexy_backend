  expires_at timestamp
  payment_provider varchar
  payment_reference varchar
  provider_subscription_reference varchar
  enabled_by int
  enabled_at timestamp
  disabled_at timestamp
  data jsonb
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table manual_subscriptions {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  vendor_id int
  status varchar
  plan_id varchar
  ends_at timestamp
  remarks text
  charges decimal
  charges_frequency varchar
  data jsonb
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table vendor_ai_usages {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  vendor_id int
  feature varchar
  provider varchar [default: 'groq']
  model varchar
  prompt_tokens int [default: 0]
  completion_tokens int [default: 0]
  total_tokens int [default: 0]
  raw_cost decimal [default: 0]
  billed_amount decimal [default: 0]
  currency varchar [default: 'USD']
  reference_id varchar
  metadata jsonb
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table vendor_ai_monthly_invoices {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  vendor_id int
  billing_period varchar
  invoice_number varchar [unique]
  total_calls int [default: 0]
  total_tokens int [default: 0]
  raw_cost decimal [default: 0]
  total_amount decimal [default: 0]
  currency varchar [default: 'USD']
  status varchar [default: 'pending']
  usage_breakdown jsonb
  due_date timestamp
  paid_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// ------------------------------------------------------------
// BLOG
// ------------------------------------------------------------

Table blog_categories {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  name varchar
  slug varchar [unique]
  description text
  status boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table blog_tags {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  name varchar
  slug varchar [unique]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table blog_posts {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  author_id int
  category_id int
  locale varchar [default: 'en']
  title varchar
  slug varchar [unique]
  excerpt text
  content text
  content_toc jsonb
  featured_image varchar
  status varchar [default: 'draft']
  published_at timestamp
  scheduled_at timestamp
  reading_time int [default: 1]
  views_count int [default: 0]
  seo_title varchar
  meta_description text
  meta_keywords varchar
  canonical_url varchar
  og_title varchar
  og_description text
  og_image varchar
  author_name varchar
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deleted_at timestamp
}

Table blog_post_tag {
  id int [pk, increment]
  blog_post_id int
  blog_tag_id int
}

// ------------------------------------------------------------
// SYSTEM / AUTH / INFRA
// ------------------------------------------------------------

Table auth_sessions {
  id varchar [pk, default: `uuid()`]
  user_id int
  token_hash varchar [unique]
  family_id varchar
  expires_at timestamp
  revoked_at timestamp
  created_at timestamp [default: `now()`]
}

Table verification_challenges {
  id varchar [pk, default: `uuid()`]
  user_id int
  kind varchar
  code_hash varchar
  attempts int [default: 0]
  expires_at timestamp
  consumed_at timestamp
  created_at timestamp [default: `now()`]
}

Table verifications {
  id int [pk, increment]
  user_id int
  type varchar [default: 'email']
  destination varchar
  code_hash varchar
  attempts int [default: 0]
  expires_at timestamp
  verified_at timestamp
  last_sent_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table pending_registrations {
  id int [pk, increment]
  token varchar [unique]
  email varchar
  payload text
  otp_hash varchar
  attempts int [default: 0]
  expires_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table outbox_jobs {
  id varchar [pk, default: `uuid()`]
  vendor_id int
  kind varchar
  payload jsonb
  status varchar [default: 'pending']
  attempts int [default: 0]
  available_at timestamp [default: `now()`]
  locked_at timestamp
  last_error text
  dedupe_key varchar [unique]
  created_at timestamp [default: `now()`]
}

Table webhook_receipts {
  id varchar [pk, default: `uuid()`]
  provider varchar
  event_key varchar [unique]
  payload jsonb
  processed_at timestamp
  created_at timestamp [default: `now()`]
}

Table integration_credentials {
  id varchar [pk, default: `uuid()`]
  vendor_id int
  provider varchar
  external_id varchar
  secret text
  metadata jsonb
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table audit_events {
  id varchar [pk, default: `uuid()`]
  vendor_id int
  actor_id int
  action varchar
  resource varchar
  resource_id varchar
  metadata jsonb
  created_at timestamp [default: `now()`]
}

Table api_keys {
  id varchar [pk, default: `uuid()`]
  vendor_id int
  user_id int
  key_hash varchar [unique]
  permissions jsonb
  expires_at timestamp
  revoked_at timestamp
  created_at timestamp [default: `now()`]
}

Table native_memberships {
  id varchar [pk, default: `uuid()`]
  vendor_id int
  user_id int
  role varchar
  permissions jsonb
  active boolean [default: true]
}

Table native_booking_claims {
  id varchar [pk, default: `uuid()`]
  vendor_id int
  resource_id int
  appointment_id int
  slot timestamp
}

Table native_idempotency {
  id varchar [pk, default: `uuid()`]
  vendor_id int
  key varchar
  request_hash varchar
  response jsonb
  created_at timestamp [default: `now()`]
}

Table native_media {
  id varchar [pk, default: `uuid()`]
  vendor_id int
  owner_id int
  path varchar
  mime_type varchar
  size int
  original_name varchar
  created_at timestamp [default: `now()`]
}

Table native_channel_messages {
  id varchar [pk, default: `uuid()`]
  vendor_id int
  contact_id int
  provider varchar
  external_account_id varchar
  external_message_id varchar [unique]
  text text
  incoming boolean
  status varchar
  created_at timestamp [default: `now()`]
}

Table jobs {
  id int [pk, increment]
  queue varchar
  payload text
  attempts int
  reserved_at int
  available_at int
  created_at int
}

Table failed_jobs {
  id int [pk, increment]
  uuid varchar [unique, default: `uuid()`]
  connection varchar
  queue varchar
  payload text
  exception text
  failed_at timestamp
}

Table activity_logs {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  user_id int
  vendor_id int
  user_role_id int
  activity jsonb
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table login_logs {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  user_id int
  ip_address varchar
  email varchar
  role int
  data jsonb
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table login_attempts {
  id int [pk, increment]
  ip_address varchar
  attempts int
  created_at timestamp
  updated_at timestamp
}

Table countries {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  name varchar
  phone_code varchar
  iso_code varchar
  name_capitalized varchar
  iso3_code varchar
  iso_num_code int
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table configurations {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  name varchar
  value text
  data_type int
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table pages {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  title varchar
  content text
  status int
  show_in_menu int
  type int
  vendor_id int
  slug varchar
  image_name varchar
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table google_sheet_automations {
  id int [pk, increment]
  uid varchar [unique, default: `uuid()`]
  vendor_id int
  title varchar
  trigger_type varchar [default: 'new_row']
  status int [default: 1]
  config jsonb
  generated_script text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Legacy / SQLite snapshot tables
Table message_labels {
  id int [pk, increment]
  uid varchar
  status int
  labels_id int
  whatsapp_message_logs_id int
  created_at timestamp
  updated_at timestamp
}

Table tickets {
  id int [pk, increment]
  uid varchar
  status int
  contacts_id int
  vendor_id int
  subject varchar
  description text
  priority varchar
  vendor_users_id int
  assigned_users_id int
  data text
  created_at timestamp
  updated_at timestamp
}

Table transactions {
  id int [pk, increment]
  uid varchar
  status int
  amount decimal
  reference_id varchar
  notes text
  data text
  vendor_id int
  subscriptions_id int
  type varchar
  manual_subscriptions_id int
  created_at timestamp
  updated_at timestamp
}

Table user_settings {
  id int [pk, increment]
  key_name varchar
  value text
  data_type int
  user_id int
  created_at timestamp
  updated_at timestamp
}

Table password_resets {
  id int [pk, increment]
  email varchar
  token varchar
  created_at timestamp
}

Table legacy_migrations {
  id int [pk, increment]
  migration varchar
  batch int
}

