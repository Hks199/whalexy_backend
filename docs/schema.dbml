  trial_ends_at timestamp
  logo_image varchar
  slug varchar
  domain varchar
  favicon varchar
  data jsonb
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  Note: 'Primary tenant / organization'
}

