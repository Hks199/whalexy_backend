{
  "name": "whalexy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Whalexy Express/TypeScript migration with PostgreSQL and Prisma",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/src/server.js",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:audit-source": "python scripts/sqlite_schema_audit.py",
    "db:archive-source": "node scripts/archive_sqlite_snapshot.mjs",
    "db:import-plan": "node scripts/native_sqlite_import.mjs",
    "db:import-validate": "node scripts/native_sqlite_import.mjs --apply",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:drift": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script --exit-code",
    "migration:inventory": "python scripts/source_inventory.py",
    "parity": "python scripts/parity_report.py",
    "migration:audit": "python scripts/audit_conversion.py",
    "migration:remaining": "python scripts/remaining_work.py",
    "migration:translations": "tsx scripts/translation_import_plan.ts",
    "test:evidence": "vitest run --reporter=default --reporter=json --outputFile=migration/test-results.json",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run architecture:check && npm run format:check && npm run db:validate && npm run typecheck && npm test && npm run build",
    "architecture:check": "node scripts/check_architecture.mjs",
    "format": "prettier --write src tests scripts/build.mjs scripts/check_architecture.mjs scripts/generate_project_guide.mjs docs/ARCHITECTURE.md docs/READING_THE_CODE.md docs/FEATURE_INDEX.md README.md",
    "format:check": "prettier --check src tests scripts/build.mjs scripts/check_architecture.mjs scripts/generate_project_guide.mjs docs/ARCHITECTURE.md docs/READING_THE_CODE.md docs/FEATURE_INDEX.md README.md",
    "docs:structure": "node scripts/generate_project_guide.mjs",
    "migration:routes": "python scripts/legacy_route_inventory.py",
    "migration:node-routes": "node --import tsx scripts/node_route_inventory.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "file-type": "^21.0.0",
    "gettext-parser": "^9.1.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "1.9.1",
    "joi": "^18.0.1",
    "jose": "^6.1.0",
    "luxon": "^3.7.2",
    "marked": "^18.0.14",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.17.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "6.19.3",
    "sanitize-html": "^2.18.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/gettext-parser": "^9.0.0",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pdfkit": "^0.17.3",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "prettier": "3.9.9",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "^3.20.0",
      "deepmerge-ts": "^8.0.2"
    }
  }
}
